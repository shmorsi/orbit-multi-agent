{
  "base_model": "Qwen/Qwen2.5-1.5B-Instruct",
  "method": "qlora",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "learning_rate": 0.0002,
  "num_train_epochs": 2,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "max_seq_length": 768,
  "warmup_ratio": 0.03,
  "logging_steps": 10,
  "seed": 7,
  "gradient_checkpointing": true,
  "bnb_4bit_quant_type": "nf4",
  "train_file": "finetune/data/distill/train.jsonl",
  "tune_file": "finetune/data/distill/tune.jsonl",
  "teacher_model": "gemini-2.5-flash",
  "teacher_max_requests": 800,
  "teacher_requests_per_minute": 8,
  "teacher_attempts": 3,
  "stop_on_http_status": 429
}
